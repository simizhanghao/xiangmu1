# Frozen paths
export SOURCE_REPO=/data1/hcc/deepresearch
export PROJECT_ROOT=/data1/hcc/deepresearch/Dee
export LLAMAFACTORY_ROOT=/data1/hcc/LlamaFactory
export LLAMAFACTORY_PYTHON=$LLAMAFACTORY_ROOT/.venv/bin/python
export VEXACT_ROOT=/data1/hcc/eca-verl-vexact

# Model and data
export MODEL_ID=Qwen/Qwen3-8B
export BASE_MODEL=/data1/hcc/deepresearch/Dee/model
export SFT_ADAPTER=$PROJECT_ROOT/artifacts/sft_adapter
export SFT_MERGED=$PROJECT_ROOT/artifacts/models/qwen3_8b_sft_merged
export RL_CKPT_ROOT=$PROJECT_ROOT/artifacts/evidence_grpo_ckpt
export SFT_DATA_DIR=$PROJECT_ROOT/data/sft
export FROZEN_DEV=$PROJECT_ROOT/data/eval/hotpotqa_200.jsonl
export RL_TRAIN_SOURCE=$PROJECT_ROOT/data/rl/train.parquet
export RL_VAL_SOURCE=$PROJECT_ROOT/data/rl/val.parquet
export RL_TRAIN=$PROJECT_ROOT/data/rl/train_verl.parquet
export RL_VAL=$PROJECT_ROOT/data/rl/val_verl.parquet
export BM25_INDEX=$PROJECT_ROOT/data/rl/contexts_index.jsonl

# Frozen hardware/protocol defaults
export CUDA_VISIBLE_DEVICES=0,1,2,3
export N_GPUS=4
export RETRIEVER_PORT=8001
export ECA_EVIDENCE_WEIGHT=0.5
export GRPO_BATCH=32
export GRPO_N=4
export GRPO_MINI_BATCH=8
export GRPO_MICRO_BATCH=1
# 8B stays on GPU Adam. 30B needed FSDP2 CPU offload and died on host RAM / 36min steps.
export GRPO_FSDP_OFFLOAD=0
export GRPO_MAX_BATCHED_TOKENS=8192
export GRPO_MAX_MODEL_LEN=8192
export GRPO_MAX_CACHE_BLOCKS=128
export GRPO_MAX_NUM_SEQS=16
# Keep PP=4 so hybrid rollout and actor do not share a full replica on one GPU.
export GRPO_PP_SIZE=4
